#!/bin/bash -l
#SBATCH --job-name=interproscan
#SBATCH --time=4:00:00
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATC H --partition=gpu   # (uncomment if your cluster requires a GPU partition)

set -euo pipefail

cd /mnt/home/aminoroa/DPFunc

module purge
module load Miniforge3
module load CUDA/12.6.0
conda activate py38dgl
module load InterProScan/5.72-103.0-foss-2023b
module load InterProScan_data/5.72-103.0-foss-2023b

IN=./processed_file/myproteins.fasta
OUTDIR=./processed_file/interproscan_out
mkdir -p "${OUTDIR}"

OUTTSV="${OUTDIR}/myproteins.interproscan.tsv"

interproscan.sh \
  -i "${IN}" \
  -f tsv \
  -o "${OUTTSV}" \
  -iprlookup \
  -goterms \
  -cpu "${SLURM_CPUS_PER_TASK}"

echo "InterProScan finished. Output: ${OUTTSV}"